# Copy to .env (gitignored) and fill in. Blank values count as unset.

# Bot token from @BotFather. For local runs use a separate test bot, never the production token.
# This is the primary bot (production: @reverseSearch2Bot).
BOT_TOKEN=
# Optional: more bots answered by the same process, comma-separated tokens (production: @MikkeSauceBot).
# They share the searches, the cache, the quotas and the flood protection; each answers its own updates.
EXTRA_BOT_TOKENS=
# SauceNAO API key: https://saucenao.com/user.php?page=search-api
# The shared key. Users can add their own with /apikey; favourite-group photos always use this one.
SAUCENAO_API_KEY=
# Optional trace.moe API key (sponsors get a higher quota): https://trace.moe/account
# Without it the 🎬 Anime scene button searches as a guest: 100 searches a day for the
# server's IP, one at a time.
TRACE_MOE_API_KEY=

# Owner reports: comma-separated user ids. Each admin must have pressed Start in every bot.
ADMIN_IDS=
# An activity report for every search, found or not (SauceNAO and the 🎬 trace.moe search,
# in chats and inline): the searched image, the outcome, who asked and where, the bot, and
# whether the answer came from the cache or a user's own key. Sent silently; a failed search
# is in it. Also who added, removed or had a rejected SauceNAO key of their own (never the key).
REPORT_RESULTS=true
# Every error: handler failures, and failed searches when REPORT_RESULTS is off.
REPORT_ERRORS=true

# Comma-separated chat ids where every photo is searched automatically.
FAVOURITE_GROUPS=

# Where Mikke keeps what must survive restarts: mikke.sqlite3 with the SauceNAO keys users
# add with /apikey. ./data by default. Production: leave it out, docker-compose.yml sets /data,
# the mikke-data volume.
DATA_DIR=

# polling (local) or webhook (production)
BOT_MODE=polling
# Public base URL of the bots' HTTP server, without a trailing slash.
# Webhooks are registered at <PUBLIC_URL>/ for the primary bot and <PUBLIC_URL>/<bot id>/
# for each extra bot; fallback image links point to <PUBLIC_URL>/img/<bot id>/<file_id>.
# Required in webhook mode; when unset, file searches get no links to other search
# engines (Google Lens, Yandex, Bing, SauceNAO, ascii2d, TinEye).
# Production: https://anybyte.org/telebot/mikke
PUBLIC_URL=
# Secret token Telegram sends in X-Telegram-Bot-Api-Secret-Token; required in webhook mode.
# 1-256 characters of A-Z a-z 0-9 _ -, e.g. `openssl rand -hex 32`. This is the primary
# bot's; each extra bot's is derived from it and the bot id, so there is nothing more to set.
WEBHOOK_SECRET=

# The HTTP server (webhook, /img/, /healthz) listens here in both modes.
WEB_HOST=0.0.0.0
WEB_PORT=8080

LOG_LEVEL=INFO

# Sentry error monitoring; leave SENTRY_DSN blank to turn it off.
# Production: the DSN of the mikke-bot project (Sentry org nicosmile).
SENTRY_DSN=
# production by default; use development for local runs
SENTRY_ENVIRONMENT=
# Share of requests traced for performance, 0.0-1.0. Errors are always sent.
SENTRY_TRACES_SAMPLE_RATE=0.0
# The release is baked into the Docker image by CI (mikke-bot@<commit sha>); no need to set it here.
